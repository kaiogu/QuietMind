<resources>
    <declare-styleable name="SmoothCheckBox">
        <attr name="duration" format="integer"/>
        <attr name="text" format="string"/>
        <attr name="stroke_width" format="dimension"/>
        <attr name="color_tick" format="color"/>
        <attr name="color_checked" format="color"/>
        <attr name="color_unchecked" format="color"/>
        <attr name="color_unchecked_stroke" format="color"/>
    </declare-styleable>

    <declare-styleable name="WheelView">
        <attr name="wvHighlightColor" format="color"/>
        <attr name="wvMarkColor" format="color"/>
        <attr name="wvTextColor" format="color"/>
        <attr name="wvItemSpacing" format="dimension"/>
        <attr name="wvMarkRatio" format="float"/>
    </declare-styleable>
</resources>
